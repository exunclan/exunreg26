{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exunreg26",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exunreg26",
      "database_id": "862a3793-af1d-48fd-bad0-10fa135228dc"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "reg.exunclan.com/*",
      "zone_name": "exunclan.com"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "ADMIN_EMAILS": "exun@dpsrkp.net,admin@exunclan.com,support@exunclan.com,roboknights@dpsrkp.net,d2s@dpsrkp.net,cubxl@dpsrkp.net",
    "QDRANT_COLLECTION": "exunreg26-kb"
  }
}
